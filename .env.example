# NOCTARA — Environment Configuration Contract
# All keys must remain server-side and never be exposed in client bundles.

# App Identity & URL
NEXT_PUBLIC_APP_NAME=NOCTARA
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth & Database (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Model Provider 1: Google Gemini (Primary)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro

# Model Provider 2: TokenRouter (Second Primary)
TOKENROUTER_API_KEY=your-tokenrouter-api-key
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_DEFAULT_MODEL=z-ai/glm-5.3-free

# Model Provider 3: OpenRouter (Fallback)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Voice Providers (Optional / Tiered)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_NOX_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_ARIA_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Cache & Hot State (Optional)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Autonomous Worker & Sandboxing
AGENT_WORKER_URL=http://localhost:4000
AGENT_WORKER_AUTH_TOKEN=generate-a-secure-random-secret
SANDBOX_WORKTREES_DIR=.sandbox/worktrees

# GitHub App Integration (Optional for local dev)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Root Security
ROOT_PASSPHRASE_HASH=
SESSION_SECRET=change-this-to-a-32-character-secret
ENCRYPTION_KEY=change-this-to-a-32-character-secret
